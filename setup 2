import os
import subprocess
import sys


def ask_user_for_confirmation(prompt: str) -> bool:
    while True:
        user_input = input(prompt).strip().lower()
        if user_input == "y":
            return True
        if user_input == "n":
            return False
        print("Invalid input. Please use only 'y' or 'n'.")


def in_conda() -> bool:
    return "CONDA_DEFAULT_ENV" in os.environ


def in_venv() -> bool:
    return hasattr(sys, "real_prefix") or (
        hasattr(sys, "base_prefix") and sys.base_prefix != sys.prefix
    )


if __name__ == "__main__":
    if in_conda():
        print("Detected conda environment:", os.environ.get("CONDA_DEFAULT_ENV"))
    elif in_venv():
        print("Detected virtual environment:", sys.prefix)
    else:
        print("No conda or virtual environment detected. Aborting...")
        raise EnvironmentError("Please activate a conda or virtual environment first.")

    print("Starting setup...")

    mujoco_path = os.path.join(os.path.dirname(__file__), "mujoco")
    if not os.path.exists(mujoco_path):
        print("Cloning the MuJoCo repository...")
        subprocess.check_call(
            ["git", "clone", "https://github.com/deepmind/mujoco.git"],
            cwd=os.path.dirname(__file__),
        )
        print("Done!")
    else:
        print("MuJoCo repository already cloned or folder exists. Skipping...")

    blackwell = False
    print("Installing dependencies...")
    if ask_user_for_confirmation("Blackwell GPU? (y/n): "):
        subprocess.check_call(
            [
                sys.executable,
                "-m",
                "pip",
                "install",
                "-r",
                os.path.join(os.path.dirname(__file__), "requirements_blackwell.txt"),
            ]
        )
        blackwell = True
    else:
        subprocess.check_call(
            [
                sys.executable,
                "-m",
                "pip",
                "install",
                "-r",
                os.path.join(os.path.dirname(__file__), "requirements.txt"),
            ]
        )
    print("Done!")

    if blackwell:
        print("Torch installation for Blackwell-series GPUs is not handled here.")
        print(
            "Try: pip install torch torchvision torchaudio "
            "--index-url https://download.pytorch.org/whl/cu129"
        )

    print("Setup complete!")
    print("Run the demo with: python burpee_robot.py")