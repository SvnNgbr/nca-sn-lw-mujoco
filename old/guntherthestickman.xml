<mujoco model="guntherthestickman">
    <compiler angle="degree"/>

    <default>
        <joint armature="0.01" damping=".1" limited="true"/>
        <geom condim="3" friction=".5 .1 .1" rgba="0.8 0.6 .4 1"/>
    </default>

    <option integrator="Euler" timestep="0.01"/>

    <worldbody>
        <geom name="floor" pos="0 0 0" size="10 10 0.5" type="plane" rgba="0.8 0.9 0.8 1"/>
        <light diffuse=".8 .8 .8" dir="0 -.5 1" pos="0 0 5"/>

        <!-- Basis-Rumpf (Torso) -->
        <body name="torso" pos="0 0 1.5">
            <inertial pos="0 0 0" mass="20" diaginertia="0.1 0.1 0.1"/>
            <freejoint name="root"/>
            <geom name="torso_geom" size="0.05 0.2" type="cylinder" rgba="0 0.5 0.5 1"/>

            <!-- Kopf -->
            <body name="head" pos="0 0 0.3">
                <inertial pos="0 0 0" mass="1" diaginertia="0.1 0.1 0.1"/>
                <geom name="head_geom" size="0.1" type="sphere" rgba="0 0.5 0.5 1"/>
                <joint axis="0 1 0" name="head_joint" range="-20 20" type="hinge"/>
            </body>

            <!-- Rechter Arm -->
            <body name="right_upper_arm" pos="0.07 0 0.1">
                <inertial pos="0 0 0" mass="2" diaginertia="0.1 0.1 0.1"/>
                <joint axis="0 0 1" name="right_shoulder_z" range="-90 90" type="hinge"/>
                <joint axis="0 1 0" name="right_shoulder_y" range="-180 90" type="hinge"/>
                <geom name="right_upper_arm_geom" size="0.03 0.15" type="cylinder" rgba="0.5 0 0.5 1"/>
                <!-- Unterer Arm -->
                <body name="right_lower_arm" pos="0 0 -0.15">
                    <inertial pos="0 0 0" mass="1" diaginertia="0.1 0.1 0.1"/>
                    <joint axis="0 1 0" name="right_elbow" range="0 150" type="hinge"/>
                    <geom name="right_lower_arm_geom" size="0.03 0.15" type="cylinder" rgba="0.5 0 0.5 1"/>
                </body>
            </body>

            <!-- Linker Arm -->
            <body name="left_upper_arm" pos="-0.07 0 0.1">
                <inertial pos="0 0 0" mass="2" diaginertia="0.1 0.1 0.1"/>
                <joint axis="0 0 1" name="left_shoulder_z" range="-90 90" type="hinge"/>
                <joint axis="0 1 0" name="left_shoulder_y" range="-90 180" type="hinge"/>
                <geom name="left_upper_arm_geom" size="0.03 0.15" type="cylinder" rgba="0.5 0 0.5 1"/>
                <!-- Unterer Arm -->
                <body name="left_lower_arm" pos="0 0 -0.15">
                    <inertial pos="0 0 0" mass="1" diaginertia="0.1 0.1 0.1"/>
                    <joint axis="0 1 0" name="left_elbow" range="0 150" type="hinge"/>
                    <geom name="left_lower_arm_geom" size="0.03 0.15" type="cylinder" rgba="0.5 0 0.5 1"/>
                </body>
            </body>

            <!-- Rechter Oberschenkel (Upper Leg) -->
            <body name="right_upper_leg" pos="0.03 -0.2 0">
                <inertial pos="0 0 0" mass="5" diaginertia="0.1 0.1 0.1"/>
                <joint axis="0 1 0" name="right_hip" range="-120 60" type="hinge"/>
                <geom name="right_upper_leg_geom" size="0.03 0.2" type="cylinder" rgba="0.5 0.5 0 1"/>
                <!-- Unterschenkel (Lower Leg) -->
                <body name="right_lower_leg" pos="0 0 -0.2">
                    <inertial pos="0 0 0" mass="3" diaginertia="0.1 0.1 0.1"/>
                    <joint axis="0 1 0" name="right_knee" range="0 150" type="hinge"/>
                    <geom name="right_lower_leg_geom" size="0.03 0.2" type="cylinder" rgba="0.5 0.5 0 1"/>
                </body>
            </body>

            <!-- Linker Oberschenkel -->
            <body name="left_upper_leg" pos="-0.03 -0.2 0">
                <inertial pos="0 0 0" mass="5" diaginertia="0.1 0.1 0.1"/>
                <joint axis="0 1 0" name="left_hip" range="-120 60" type="hinge"/>
                <geom name="left_upper_leg_geom" size="0.03 0.2" type="cylinder" rgba="0.5 0.5 0 1"/>
                <!-- Unterschenkel (Lower Leg) -->
                <body name="left_lower_leg" pos="0 0 -0.2">
                    <inertial pos="0 0 0" mass="3" diaginertia="0.1 0.1 0.1"/>
                    <joint axis="0 1 0" name="left_knee" range="0 150" type="hinge"/>
                    <geom name="left_lower_leg_geom" size="0.03 0.2" type="cylinder" rgba="0.5 0.5 0 1"/>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <!-- Right side -->
        <!-- Arm -->
        <motor name="right_shoulder_z_motor" joint="right_shoulder_z" gear="100"/>
        <motor name="right_shoulder_y_motor" joint="right_shoulder_y" gear="100"/>
        <motor name="right_elbow_motor" joint="right_elbow" gear="50"/>
        <!-- Leg -->
        <motor name="right_knee_motor" joint="right_knee" gear="150"/>
        <motor name="right_hip_motor" joint="right_hip" gear="150"/>

        <!-- Left side -->
        <!-- Arm -->
        <motor name="left_shoulder_z_motor" joint="left_shoulder_z" gear="100"/>
        <motor name="left_shoulder_y_motor" joint="left_shoulder_y" gear="100"/>
        <motor name="left_elbow_motor" joint="left_elbow" gear="50"/>
        <!-- Leg -->
        <motor name="left_knee_motor" joint="left_knee" gear="150"/>
        <motor name="left_hip_motor" joint="left_hip" gear="150"/>
    </actuator>
</mujoco>